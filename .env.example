# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (docker-compose derives DATABASE_URL for the backend service from
# these; set DATABASE_URL directly yourself when running the backend outside
# Docker, e.g. `postgresql+asyncpg://recipe_ai:recipe_ai@localhost:5432/recipe_ai`)
# ---------------------------------------------------------------------------
POSTGRES_USER=recipe_ai
POSTGRES_PASSWORD=recipe_ai
POSTGRES_DB=recipe_ai
DATABASE_URL=postgresql+asyncpg://recipe_ai:recipe_ai@localhost:5432/recipe_ai

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# AI providers
#
# Each AI capability (vision / speech-to-text / LLM / nutrition) is configured
# independently, so any one of them can be swapped for a different provider
# without touching application code - see backend/app/ai/factory.py.
# ---------------------------------------------------------------------------
VISION_PROVIDER=openai
LLM_PROVIDER=openai
NUTRITION_PROVIDER=openai
# "local_whisper" runs speech-to-text inside the backend container (no extra API
# key, no extra cost). Set to "openai" to use OpenAI's cloud transcription API
# instead (requires OPENAI_API_KEY below either way, since the other providers
# use it too).
SPEECH_PROVIDER=local_whisper

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_NUTRITION_MODEL=gpt-4o-mini

# Only used when SPEECH_PROVIDER=local_whisper.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Whether recipe search results get an extra LLM reranking/explanation pass on
# top of the algorithmic ranking. Retrieval always works even if this is off,
# or if the AI call fails.
AI_RERANK_ENABLED=true

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# CORS (comma-separated origins the backend will accept browser requests from)
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
