# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (docker-compose derives DATABASE_URL for the backend service from
# these; set DATABASE_URL directly yourself when running the backend outside
# Docker, e.g. `postgresql+asyncpg://recipe_ai:recipe_ai@localhost:5432/recipe_ai`)
# ---------------------------------------------------------------------------
POSTGRES_USER=recipe_ai
POSTGRES_PASSWORD=recipe_ai
POSTGRES_DB=recipe_ai
DATABASE_URL=postgresql+asyncpg://recipe_ai:recipe_ai@localhost:5432/recipe_ai

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# AI providers
#
# Each AI capability (vision / speech-to-text / LLM extraction / recipe
# generation) is configured independently, so any one of them can be swapped
# for a different provider without touching application code - see
# backend/app/ai/factory.py. Recipes are not looked up from a database catalog:
# RECIPE_GENERATION_PROVIDER generates them (with nutrition) directly from the
# ingredients you provide.
# ---------------------------------------------------------------------------
VISION_PROVIDER=openai
LLM_PROVIDER=openai
RECIPE_GENERATION_PROVIDER=openai
# "local_whisper" runs speech-to-text inside the backend container (no extra API
# key, no extra cost). Set to "openai" to use OpenAI's cloud transcription API
# instead (requires OPENAI_API_KEY below either way, since the other providers
# use it too).
SPEECH_PROVIDER=local_whisper

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_RECIPE_GENERATION_MODEL=gpt-4o-mini

# Only used when SPEECH_PROVIDER=local_whisper.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# How many distinct recipes to generate per search by default.
RECIPES_PER_SEARCH=5

# ---------------------------------------------------------------------------
# Unsplash (recipe photos)
#
# Optional. Each generated recipe is matched to a photo via Unsplash's search
# API. Leave blank to run without recipe photos (they just won't be sent to
# the frontend) - unlike OPENAI_API_KEY, this is never required at startup.
# Get a free Access Key (50 req/hour on the free tier) at
# https://unsplash.com/oauth/applications -> New Application.
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# CORS (comma-separated origins the backend will accept browser requests from)
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
